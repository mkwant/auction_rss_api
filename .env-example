# Settings for the Traefik reverse proxy
TRAEFIK_USERNAME=<username>
TRAEFIK_PASSWORD=<username>
TRAEFIK_HASHED_PASSWORD=<hashed password, in quotes!>
TRAEFIK_DASHBOARD_URL=
TRAEFIK_LETS_ENCRYPT_EMAIL=
APPLICATION_URL=

# Settings for OpenObserve
OPENOBSERVE_URL=
OPENOBSERVE_USER_EMAIL=
OPENOBSERVE_USER_PASSWORD=
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of email:password>

# Settings for the AuctionRssApi
LOG_LOCATION=.logs/auction_rss_api.log
LOG_LEVEL=INFO
TRANSLATE_CACHE_DIR=.translation_cache
CAMOUFOX_PROFILE_DIR=.profile

# Ebay API Settings
EBAY_APP_ID=
EBAY_APP_SECRET=
EBAY_RU_NAME=

# MS Translate API settings
MS_TRANSLATE_API_KEY=
MS_TRANSLATE_API_LOCATION=westeurope

# Watchtower settings
TZ=Europe/Amsterdam
WATCHTOWER_CLEANUP=True
WATCHTOWER_POLL_INTERVAL=60
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_NOTIFICATIONS_HOSTNAME=
